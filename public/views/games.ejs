<!DOCTYPE html>
<html>
<head>
    <link href="/css/games.css" rel="stylesheet" type="text/css">
    <link rel="icon" type="image/x-icon" href="/images/favicon.ico">
</head>
<body>
    <%- include('header.ejs') %>
    <div class="main-div">
        <div class="search-functions" style="display:inline-table; width:100%; margin-bottom:4px; margin-top:4;">
            <% if (Number(page) <= 1) { %>
                <div class="dead-button">
                    &lt;
                </div>
            <% } else { %>
                <a href="/games/?page=<%=Number(page) - 1%>&search=<%=search%>">
                    <div class="link-button">
                        &lt;
                    </div>
                </a>
            <% } %>
            <a href="/games/?page=<%=Number(page)%>&search=<%=search%>">
                <div class="link-button">
                    Page <%=Number(page)%>
                </div>
            </a>
            <% if (games.length == 0) { %>
                <div class="dead-button">
                    &gt;
                </div>
            <% } else { %>
                <a href="/games/?page=<%=Number(page) + 1%>&search=<%=search%>">
                    <div class="link-button">
                        &gt;
                    </div>
                </a>
            <% } %>
            <div style="display: flex; align-items: center; height: 40px;">
                <label for="searchbar" style="margin-left: 2%;"> Search: </label>
                <input class="placeholder" id="searchbar" type="text" placeholder="Search" name="searchbar" 
                style="margin-left: 2%; margin-top: 30px;">
                <% if (search) { %>
                    <p style="margin-left: 2%;"> Currently searching for: <%= search%></p>
                <% } %>
            </div>
        </div>
        <div class="games-div">
            <% if (games.length > 0) { %>
                <% games.forEach(function(game) { %>
                <div class="game" id="g<%= game.id %>">
                    <a href="/g/<%= game.id %>">
                        <div class="game_cover" style="background-image: url('<%= game.cover_image %>')"></div>
                    </a>
                    <div class="banner"> 
                        <a class="game_title" href="/g/<%= game.id %>"> <%= game.name %> </a>
                    </div>
                </div>
                <% }); %>
            <% } else { %>
                <p>No games :/</p>
            <% } %>
        </div>
    </div>
    <script src="/js/games.js" type="module"></script>
</body>
</html>