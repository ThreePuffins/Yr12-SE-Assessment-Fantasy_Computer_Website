<!DOCTYPE html>
<html>
<head>
  <link href="/css/games.css" rel="stylesheet" type="text/css">
</head>
<body>
    <%- include('header.ejs') %>
    <div style="display:flex; flex-direction:row; flex-wrap: wrap; padding:4px;">
        <% if (games.length > 0) { %>
            <% games.forEach(function(game) { %>
            <div class="game" id="g<%= game.id %>">
                <a href="/g/<%= game.id %>">
                    <div class="game_cover" style="background-image: url('/<%= game.cover_image %>')"></div>
                </a>
                <div class="banner"> 
                    <a class="game_title" href="/g/<%= game.id %>"> <%= game.name %> </a>
                </div>
            </div>
            
            <% }); %>
        <% } else { %>
            <p>No games :/</p>
        <% } %>
    </div>
</body>
</html>