<!DOCTYPE html>
<html>
<head>
  <title><%= username %></title>
  <link rel="icon" type="image/x-icon" href="/images/favicon.ico">
  <link href="/css/games.css" rel="stylesheet" type="text/css">
</head>
<body>
  <%- include('header.ejs') %>
  <div class="main-div">
    <h1><%= username %> (This is your profile)</h1>
    <hr>
    <% if (games.length > 0) { %>
      <div class="user-games-container">
        <% games.forEach(function(game) { %>
        <div style="display: flex; flex-direction: row;">
          <div class="game" id="g<%= game.id %>">
              <a href="/g/<%= game.id %>">
                  <div class="game_cover" style="background-image: url('<%= game.cover_image %>')"></div>
              </a>
              <div class="banner"> 
                  <a class="game_title" href="/g/<%= game.id %>"> <%= game.name %> </a>
              </div>
          </div>
          <div class="description">
            <textarea class="title-input" id="title-input-<%= game.id %>" type="text" placeholder="Enter Title" 
              style="resize: none;"><%= game.name %></textarea>
            <textarea class="description-input" id="game-description-<%= game.id %>" type="text" placeholder="Enter Description" 
              style="resize: none;"><%= game.description%></textarea>
          </div>
        </div>
        <div style="display: flex; flex-direction: row;">
          <div style="display: flex; flex-direction: column;">
            <label for="program-input-<%= game.id %>"><b>Select Game File</b></label>
            <input type="file" id="program-input-<%= game.id %>">
          </div>
          <div style="display: flex; flex-direction: column;">
            <label for="cover-input-<%= game.id %>"><b>Select Cover File</b></label>
            <input type="file" id="cover-input-<%= game.id %>">
          </div>
          <button id="uploadgame-<%= game.id %>" class="updatebtn btn">Update</button>
          <button id="deletegame-<%= game.id %>" class="btn btn-danger deletebtn" style="margin-left: 4%"
            onclick="document.getElementById('del-acc-overlay').style.display='block'">Delete</button>
        </div>
        <hr style="width:100%;">
        <% }); %>
      </div>
    <% } else { %>
      <p>You haven't released any games. Consider <a href="/upg">uploading</a> a game.</p>
    <% } %>
  </div>
  <script src="/js/user_page.js" type="module"></script>

  <div class="modal" id="del-acc-overlay">
  <form id="delete-account-form" class="modal-content" method="POST">
    <div class="form-container">
      <h1>Are you sure?</h1>
      <hr>
      <button type="button" onclick="document.getElementById('del-acc-overlay').style.display='none'" class="cancelbtn">Cancel</button>
      <button type="submit" class="btn btn-danger">Delete Game</button>
    </div>
  </form>
  <script src="/js/delete_game.js" type="module"></script>
</div>
</body>
</html>

