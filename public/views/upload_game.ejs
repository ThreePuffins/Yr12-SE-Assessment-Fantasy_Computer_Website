<!DOCTYPE html>
<html>
<head>
  <link href="/css/games.css" rel="stylesheet" type="text/css">
  <link rel="icon" type="image/x-icon" href="/images/favicon.ico">
  <title>Upload Game</title>
</head>
<body>
  <%- include('header.ejs') %>
  <div class="main-div">
    <% if (session) {%>
    <label for="game-title"><b>Game Title</b></label>
    <input class="placeholder" id="game-title" type="text" placeholder="Enter Game Name">
    <label for="game-description"><b>Description</b></label>
    <input class="placeholder" id="game-description" type="text" placeholder="Enter Description">
    <label for="program-input"><b>Select Game File</b></label>
    <input type="file" id="program-input">
    <button id="upload-game" class="updatebtn btn">Upload</button>
    <% } else { %>
    <p> Log in to upload games </p>
    <% } %>
  </div>
  <script src="/js/upload_game.js" type="module"></script>
</body>
</html>