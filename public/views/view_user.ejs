<!DOCTYPE html>
<html>
<head>
  <title><%= username %></title>
  <link rel="icon" type="image/x-icon" href="/images/favicon.ico">
  <link href="/css/games.css" rel="stylesheet" type="text/css">
</head>
<body>
  <%- include('header.ejs') %>
  <div class="main-div">
    <h1><%= username %></h1>
    <hr>
    <% if (games.length > 0) { %>
      <div class="user-games-container">
        <% games.forEach(function(game) { %>
        <div style="display: flex; flex-direction: row;">
          <div class="game" id="g<%= game.id %>">
              <a href="/g/<%= game.id %>" aria-label="<%= game.name %>">
                  <div class="game_cover" style="background-image: url('<%= game.cover_image %>')"></div>
              </a>
              <div class="banner"> 
                  <a class="game_title" href="/g/<%= game.id %>"> <%= game.name %> </a>
              </div>
          </div>
          <div class="description">
            <h1> <%= game.name %>: </h1>
            <p> <%= game.description %> </p>
          </div>
        </div>
        <hr style="width:100%;">
        <% }); %>
      </div>
    <% } else { %>
      <p><%= username %> has not released any games</p>
    <% } %>
  </div>
</body>
</html>