<!DOCTYPE html>
<html>
<head>
  <link href="/css/games.css" rel="stylesheet" type="text/css">
  <title><%= game.name %></title>
</head>
<body>
  <%- include('header.ejs') %>
  <div class="main-div">
    <h1 style="margin-bottom: 0"><%= game.name %></h1>
    <a href="/u/<%= game.user %>"> <%= username %> </a>
    <canvas id="canvas" oncontextmenu="event.preventDefault()" onmousedown="window.focus()"></canvas>
    <script src="/js/game_page.js"></script>
    <script src="<%= game.game_file %>"></script>
    <p> <%= game.description %> </p>
  </div>
</body>
</html>