<!DOCTYPE html>
<html>
<head>
  <link href="/css/games.css" rel="stylesheet" type="text/css">
  <link rel="icon" type="image/x-icon" href="/images/favicon.ico">
  <title><%= game.name %></title>
</head>
<body>
  <%- include('header.ejs') %>
  <div class="main-div">
    <h1 style="margin-bottom: 0"><%= game.name %></h1>
    <a href="/u/<%= game.user %>"> <%= username %> </a>
    <canvas aria-label="<%= game.name %> window" tabindex="0" id="canvas" oncontextmenu="event.preventDefault()" onmousedown="window.focus()"></canvas>
    <script src="/js/display.js"></script>
    <script src="<%= game.game_file %>"></script>
    <script src="/js/game_page.js"></script>
    <p> <%= game.description %> </p>
  </div>
</body>
</html>