<!DOCTYPE html>
<head>
    <title>Wizem</title>
    <link href="/css/header.css" rel="stylesheet" type="text/css">
    <link rel="icon" type="image/x-icon" href="/images/favicon.ico">
</head>
<nav class="navbar">
    <div class="container"> 
        <ul class="website-nav">
            <li><a href="/">Home</a></li>
            <li><a href="/games">Games</a></li>
            <li><a href="/upg">Upload</a></li>
        </ul>
        <% if (!session) { %>
        <ul class="account">
            <li><button class="accountbtn" onclick="document.getElementById('signup').style.display='block';">Signup</button></li>
            <li><button class="accountbtn" onclick="document.getElementById('login').style.display='block';">Login</li>
        </ul>
        <% } else { %>
        <div class="account-settings">
            <li onclick="document.getElementById('acc-o').style.display='block';"><%= session.username %></li>
            <div class="account-overlay" id="acc-o">
                <ul class="account-action-list">
                    <li><a href="/settings">Settings</a></li>
                    <li><a href="/auth/log_out">Log Out</a></li>
                </ul>
            </div>
        </div>
        <script src="/js/header.js" type="module"></script>
        <% } %>
    </div>
</nav>

<%- include('signup.html') %>
<%- include('login.html') %>